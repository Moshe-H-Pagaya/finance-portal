# =============================================================================
# Finance AI & Automation Portal — environment configuration
# =============================================================================
# Copy this file to .env.local for development, or set these in Cloud Run.
# Never commit a real .env file.

# Port the Express server listens on. Cloud Run injects PORT automatically.
PORT=3000

# -----------------------------------------------------------------------------
# Cards storage backend (pick one)
# -----------------------------------------------------------------------------
# Priority order at runtime:
#   1. CARDS_GCS_BUCKET set        → read+write a JSON object in GCS (recommended)
#   2. CARDS_SHEET_ID set          → read (and optionally write) a Google Sheet
#   3. Neither set                 → read-only bundled public/cards.json
#
# GCS-backed storage. Set CARDS_GCS_BUCKET to enable admin writes from the
# /admin UI. The bucket must already exist and the runtime service account
# needs roles/storage.objectAdmin on it. Enable Object Versioning on the
# bucket to keep an automatic history of edits.
CARDS_GCS_BUCKET=
CARDS_GCS_OBJECT=cards.json

# The spreadsheet ID that holds the Cards tab (replaces the Apps Script
# PROP_SHEET_ID property). Find it in the Sheet URL between /d/ and /edit.
CARDS_SHEET_ID=

# Tab name inside the spreadsheet that holds the JSON blob in cell A1.
# Matches the original Apps Script constant SHEET_NAME = 'Cards'.
CARDS_SHEET_TAB=Cards

# When true, read the sheet via the public gviz endpoint (sheet must be shared
# as "Anyone with the link, Viewer"). Writes are disabled in this mode. Use
# this when org policy blocks sharing with the runtime service account.
# When false/unset, authenticate as the runtime SA via the Sheets v4 API; the
# sheet must be shared with that SA as Editor.
SHEET_PUBLIC=false

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Comma-separated list of emails allowed to access /admin and the admin API.
# Only enforced when Cloud IAP is in front (AUTH_MODE=iap) and the
# X-Goog-Authenticated-User-Email header is present. Leave empty to skip
# the per-user gate and rely on Basic Auth alone.
ADMIN_EMAILS=

# HTTP Basic Auth credentials for /admin and admin-write API endpoints.
# Browser prompts for these on first access; password sent over HTTPS only.
# Pick a strong password and rotate it on personnel changes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-shared-secret
ADMIN_AUTH_REALM=Finance Portal Admin

# In production behind Cloud IAP, the user's identity comes from the
# X-Goog-Authenticated-User-Email header that IAP injects. Set this to 'iap'.
# For local dev set it to 'dev' which falls back to DEV_USER_EMAIL.
# For Basic-Auth-only (current deployment) leave at 'iap' with empty ADMIN_EMAILS.
AUTH_MODE=iap

# Used only when AUTH_MODE=dev. Pretend you're this user for local testing.
DEV_USER_EMAIL=you@pagaya.com

# -----------------------------------------------------------------------------
# Google service account
# -----------------------------------------------------------------------------
# When running on Cloud Run, do NOT set GOOGLE_APPLICATION_CREDENTIALS — the
# runtime service account is picked up automatically via ADC. Just share the
# Sheet with that SA's email as Editor.
#
# For local dev, point this at a downloaded SA key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json
